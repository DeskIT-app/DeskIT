# No package in this tree runs code at install time: every native piece
# the build needs (rolldown, lightningcss, the TypeScript binary) arrives
# as a platform package, and a postinstall is the one door a dependency
# has to run something on this PC before anyone read it.
ignore-scripts=true
# Every version in package.json is the exact one the lock holds.
save-exact=true
engine-strict=true
fund=false
audit=false
