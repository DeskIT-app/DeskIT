.env
.venv/
__pycache__/

# Everything below is a record of what you actually dictated — keep it off
# any remote. app.log holds the pasted text, pending\ holds raw audio, and
# vocab.json holds words you said paired with what you meant. (The seed
# terms in config.toml ARE committed — those are hand-written, not learned.)
transcripts.log*
app.log*
pending/
recent/
vocab.json

# Generated at first run by cues.py
cues/

# Generated on first run by server.py — the phone endpoint shared secret.
server_token.txt

# Android build outputs and local toolchain paths
android/.gradle/
android/build/
android/app/build/
android/local.properties
