<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's mark, split the way Android wants it: the graphite
     ground is the background layer (a full square, so whatever shape the
     launcher masks to is the tile), and the corner with its gold dot is
     the foreground. Both are drawn by dev\make_logo.py, the one source of
     icon.ico; a test holds them to it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
