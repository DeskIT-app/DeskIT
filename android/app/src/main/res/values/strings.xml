<resources>
    <string name="app_name">DeskIT</string>
    <string name="ime_label">DeskIT</string>

    <!-- Keyboard face. English on purpose: it sits under a Hebrew text
         field, and mixing scripts in the same glance is noise. The owner
         later made it the rule for the whole app (2026-09-13). -->
    <string name="hold_and_talk">Hold &amp; talk</string>
    <string name="slide_to_lock">Slide up to lock ↑ · down to discard</string>
    <!-- %1$s is m:ss. The clock is the point: a locked recording you walked
         away from has to read as still running. -->
    <string name="recording_time">Recording  %1$s</string>
    <string name="locked_time">Locked  %1$s · tap to finish</string>
    <!-- What the mic says when the words above do not fit even shrunk (a 320 dp phone
         with the largest text): the clock is what must stay. -->
    <string name="recording_short">%1$s</string>
    <string name="locked_short">Locked  %1$s</string>
    <!-- A recording the keyboard closed on is kept (the owner, 2026-11-12: "like a
         WhatsApp voice recording, where there is an option to continue it after it
         closes"). The mic itself is Continue, with the kept length; the line under it
         is the waiting row's shape: the words, Send, the round X. -->
    <string name="continue_time">Continue  %1$s</string>
    <string name="continue_short">Continue</string>
    <string name="paused_line">Recording paused</string>
    <!-- %1$d older recordings wait behind the paused one, and come back after it. -->
    <string name="paused_line_older">Recording paused · %1$d older not sent</string>
    <string name="send_kept">Send</string>
    <string name="cd_continue">Continue the paused recording</string>
    <string name="cd_send_kept">Send the paused recording</string>
    <string name="cd_drop_kept">Delete the paused recording</string>
    <string name="transcribing">Transcribing…</string>
    <string name="translating">Translating…</string>
    <string name="punctuating">Punctuating…</string>
    <string name="too_short">Too short</string>
    <string name="no_speech">No speech</string>
    <string name="discarded">Discarded</string>
    <string name="nothing_to_translate">Nothing in the field</string>
    <!-- A whole recording of silence is a held microphone, not a quiet room.
         Say so instead of uploading it and returning "No speech". -->
    <string name="no_sound">No sound — is another app using the mic?</string>
    <string name="capped">Hit the %1$s limit — sending what there is</string>

    <!-- The reply came back after the field it was meant for went away. The
         text is kept rather than written into a stranger's field. -->
    <string name="field_gone">Text ready — tap to insert it here</string>
    <string name="field_changed">The text moved on — left it alone</string>
    <string name="cannot_undo">Nothing of mine to undo</string>
    <string name="undone">Removed</string>

    <!-- A recording that did not reach the PC waits on the keyboard, an hour at
         most, and goes only on a press, into the field you are in then (the
         owner, 2026-11-10). The line says why in a few words, and only what the
         phone knows: a guess is never put as a fact. -->
    <string name="send_again">Send again</string>
    <string name="cd_send_again">Send what did not reach your PC</string>
    <string name="cd_drop_waiting">Delete what did not reach your PC</string>
    <string name="sending">Sending…</string>
    <!-- A press sends everything that waits, oldest first. -->
    <string name="sending_of">Sending %1$d of %2$d…</string>
    <string name="not_sent">Not sent</string>
    <string name="not_sent_many">%1$d not sent</string>
    <!-- %1$d is how many wait, %2$s why the last try came to nothing. -->
    <string name="not_sent_why">%1$d not sent · %2$s</string>
    <!-- Why, one kind each. Nobody answered on any road this phone has: -->
    <string name="why_no_answer">Your PC didn\'t answer</string>
    <!-- Nobody answered, and the phone is on no Wi-Fi (or Ethernet) a PC at home
         could be reached on: Wi-Fi off and Wi-Fi not connected alike, a VPN's
         network not counted (the owner, 2026-11-10). Said whenever it is true when
         the line is drawn, and the keyboard's open line says it too. -->
    <string name="why_no_wifi">Your phone isn\'t on Wi-Fi</string>
    <!-- The PC answered that its model is unloaded (Stop in the desk, or room for a game): -->
    <string name="why_model_off">The model is off on your PC</string>
    <!-- The PC answered that it has no account signed in: -->
    <string name="why_signed_out">Your PC is signed out</string>
    <!-- The PC answered that its model is not downloaded, not finished, or old: -->
    <string name="why_no_model">Your PC\'s speech model isn\'t ready</string>
    <!-- The phone could not open what it sealed: locked, or its Keystore not answering. -->
    <string name="why_locked">The phone was locked</string>
    <string name="why_keystore">The phone\'s secure storage didn\'t answer</string>
    <!-- The pasted line's token, refused by the PC it points at: -->
    <string name="why_token">Your PC refused the token</string>
    <!-- Something answered, and not with anything the phone could read: -->
    <string name="why_unreadable">Couldn\'t read the answer</string>
    <!-- The PC answered with an error and no sentence of its own: -->
    <string name="why_error">Your PC answered with error %1$d</string>

    <!-- The cloud backup (PHONE_LINK_PLAN.md stage 2b, the words he approved in
         pictures on 2026-11-11). No PC answered, so the recording went to the
         person's own provider with their own key: the line says so while it is
         on its way, and on every dictation that went that way. %1$s is Groq or
         Gemini. -->
    <string name="transcribing_cloud">Transcribing in the cloud…</string>
    <string name="from_the_cloud">from the cloud (%1$s)</string>
    <!-- The keyboard's line after a PC's text came through the account, away from home:
         "3.7 s · local via your account". -->
    <string name="via_account">via your account</string>
    <!-- Home, away from home, a PC there through the account (stage 3). -->
    <string name="home_via_account">Away from home, through your account.</string>
    <!-- Away from home with no key and no PC: the button stands where Send
         again stands, only while there is no road (the owner's d2). -->
    <string name="add_a_key">Add a key</string>
    <string name="cd_add_a_key">Add a cloud key, in Settings</string>
    <!-- Why the cloud did not take it, on the waiting row: -->
    <string name="why_key_refused">%1$s refused your key</string>
    <string name="why_limit">%1$s\'s free limit is used up for now</string>
    <string name="why_cloud">%1$s: %2$s</string>

    <!-- A password field is not a place to dictate: the audio and the text
         would both leave the phone, and the text would land in
         transcripts.log on the PC for good. -->
    <string name="private_field">Not here — this field is private</string>

