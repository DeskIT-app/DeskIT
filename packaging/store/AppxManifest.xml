<?xml version="1.0" encoding="utf-8"?>
<!--
  The Store package (DISTRIBUTION_PLAN.md 10.7). build_msix.ps1 replaces
  {VERSION} with the release's X.Y.Z.0 (the Store wants the fourth number
  0) and copies this beside python\ and app\.

  Identity: the values Partner Center assigned when "DeskIT App" was
  reserved on 2026-10-02 (Store ID 9PCJJQV52NVZ). The Publisher's hash is
  the family name's suffix, d0r2ms77220w6 — tests.py recomputes it, so a
  mistyped character fails here and not at upload. Properties/DisplayName
  must be the reserved name; the tile and the Start menu say DeskIT.

  Three doors, one tree (packaging/store/launcher.c): DeskIT.exe is the
  application; DeskITQuiet.exe is what the startup task starts (the Run
  value's own deskit.pyw with the quiet switch, autostart.py; an XML
  comment may not hold two hyphens in a row); DeskITHook.exe is behind
  the deskit-hook.exe alias Claude Code's hook line names (notify_hook.py).

  Capabilities, each for something the app does: runFullTrust (the global
  keyboard hook, SendInput, Credential Manager, the loopback server — the
  justification is packaging/store/justification.md), internetClient (the
  model download and the consented cloud calls), privateNetworkClientServer
  (the phone on the same Wi-Fi), microphone.

  The desktop shortcut (desktop7:Shortcut, the Store walk's item 18): the
  website installer puts DeskIT on the desktop because he closed a copy
  once and could not find it again, and an MSIX gets only what its
  manifest declares. Windows makes it at install and removes it at
  uninstall. It is called "DeskIT App", the Store's name for this copy, so
  it never collides with the website copy's DeskIT.lnk on a PC that has
  both. desktop7 needs Windows build 19645 (every Windows 11); it is in
  IgnorableNamespaces, so an older Windows 10 skips the shortcut and
  installs the rest. The logos and the index that makes their targetsize
  names count are assets.py's and priconfig.xml's.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop7="http://schemas.microsoft.com/appx/manifest/desktop/windows10/7"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop7 rescap">

  <Identity
    Name="YoavShimron.DeskITApp"
    Publisher="CN=F51974FB-3E8A-4445-A554-758D2DCE56BB"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeskIT App</DisplayName>
    <PublisherDisplayName>Yoav Shimron</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="he-il" />
  </Resources>

  <Applications>
    <Application Id="DeskIT" Executable="DeskIT.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeskIT"
        Description="Hold a key, speak, release: the text appears at the cursor."
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="DeskITQuiet.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeskITAutostart" Enabled="false" DisplayName="DeskIT" />
        </desktop:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="DeskITHook.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="deskit-hook.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <desktop7:Extension Category="windows.shortcut">
          <desktop7:Shortcut File="$(Desktop)\DeskIT App.lnk" Icon="assets\DeskIT.ico"
            Description="Hold a key, speak, release: the text appears at the cursor." />
        </desktop7:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
